{%- comment -%}
Styled 404. During provisioning this mostly means "the admin page for this
handle hasn't been created yet" (scripts/make-pages.mjs); after cutover it
is a real not-found page.
{%- endcomment -%}
{% render 'hyun-nav' %}
<section class="section-35">
  <div class="w-layout-blockcontainer container-17 w-container">
    <h1 class="heading-12">Page not found</h1>
  </div>
</section>
<section style="padding: 0 5% 10vh; text-align: center;">
  <div class="w-layout-blockcontainer main-container w-container">
    <div class="body-copy" style="margin-bottom: 32px;">
      The page you&#8217;re looking for doesn&#8217;t exist or has moved.
    </div>
    <div style="display: flex; flex-direction: column; gap: 14px; align-items: center;">
      <a href="/" class="primary-button w-button">Home</a>
      <a href="/collections/all" class="primary-button tertiarybtn w-button">Shop Japanese Wagyu</a>
    </div>
  </div>
</section>
{% render 'hyun-footer' %}
