  </div>
  <div class="div-block-3">
    <div class="columns-4 w-row">
      <div class="column-4 w-col w-col-3">
        <img src="{{ 'thlogowhite.svg' | asset_url }}" loading="lazy" width="125" alt="" class="image"/>
        <div class="div-block-26">
          <a href="/our-story" class="link">Our Story</a>
          <a href="/brand-philosophy" class="link">Brand philosophy</a>
          <a href="/design-philosophy" class="link">Design philosophy</a>
