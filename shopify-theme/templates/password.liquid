{%- comment -%}
Styled storefront password gate (dev stores are always password-protected
until a plan is chosen). Renders from the published theme, so this matters at
publish time; without it Shopify serves its bare default gate.
{%- endcomment -%}
<section style="min-height:80vh;display:flex;align-items:center;justify-content:center;">
  <div style="text-align:center;padding:40px 24px;">
    <img src="{{ 'thehyun.svg' | asset_url }}" width="160" alt="THE HYUN" style="margin-bottom:40px;"/>
    <div class="title-upper-text" style="margin-bottom:28px;">Opening soon</div>
    {%- form 'storefront_password' -%}
      <div style="display:flex;gap:10px;justify-content:center;">
        <input class="text-field-2 w-input" type="password" name="password" placeholder="Password" style="max-width:220px;"/>
        <input type="submit" class="submit-button-2 w-button" value="Enter"/>
      </div>
      {%- if form.errors -%}
        <div class="body-copy" style="margin-top:14px;color:#b00020;">Wrong password.</div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
