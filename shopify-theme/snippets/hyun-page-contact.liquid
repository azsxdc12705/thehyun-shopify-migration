{%- endcomment -%}
<section class="section-24"><div class="w-layout-blockcontainer main-container w-container"><div class="title-upper-text">We&#x27;re here to assist you!</div><h1 class="heading-12">Contact</h1></div></section><section class="section-25"><div class="w-layout-blockcontainer main-container w-container"><p class="paragraph-13">THE HYUN Customer Service</p><div class="columns-36 w-row"><div class="column-74 w-col w-col-6"><h1 class="heading-12">Submit an inquiry</h1><div class="form-block-6 w-form">{%- form 'contact', class: 'form-4' -%}
<input type="hidden" name="contact[subject]" value="Contact form"/>
<input class="contact_field w-input" maxlength="256" name="contact[name]" placeholder="Full Name" type="text" required=""/><input class="contact_field w-input" maxlength="256" name="contact[email]" placeholder="Email address" type="email" required=""/><select name="contact[topic]" class="contact_field w-select"><option value="">Select an inquiry topic</option><option value="Issue with an order">Issue with an order</option><option value="Wholesale">Wholesale</option><option value="Corporate Gifts">Corporate Gifts</option></select><textarea name="contact[body]" maxlength="5000" placeholder="Message" required="" class="contact_field w-input"></textarea>
<input type="submit" data-wait="Please wait..." class="secondary-button w-button" value="Submit"/>
{%- if form.posted_successfully? -%}<div class="text-block-54" style="margin-top:12px;">Thank you! Your submission has been received!</div>{%- elsif form.errors -%}<div class="text-block-55" style="margin-top:12px;">Oops! Something went wrong while submitting the form.</div>{%- endif -%}
{%- endform -%}</div></div><div class="column-73 w-col w-col-6"><div class="div-block-55"><div class="w-layout-hflex flex-block-2"><img src="{{ 'store-icon.svg' | asset_url }}" loading="lazy" width="23" alt=""/><div class="text-block-99">In Store Service</div></div><p class="paragraph-37">Store Hours: Monday to Sunday: 11am - 8:30pm EST<br/>Our staff is always excited to assist with all your accomodations and inquiries.</p></div><div class="div-block-55"><div class="w-layout-hflex flex-block-2"><img src="{{ 'vectorphone.svg' | asset_url }}" loading="lazy" width="23" alt=""/><div class="text-block-99">Give us a call: (000) 000-0000</div></div><p class="paragraph-37">Hours of operation:  Monday to Saturday 11am - 6:30pm EST (excluding public holidays). If we are not available, we welcome you to leave us a message.</p></div></div></div></div></section>
